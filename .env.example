# Required: powers PRD clarification/generation and AI-assisted cost analysis.
# Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Required: extracts current pricing evidence from vendor pricing pages.
# Create a key at https://app.tavily.com/home
TAVILY_API_KEY=

# Required: Supabase Auth browser client configuration.
# Keep the anon key here as a placeholder only; real values belong in .env.local
# and deployment secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required: Supabase Auth server-side session verification/admin operations.
# Never expose the service role key to client components.
SUPABASE_SERVICE_ROLE_KEY=

# Required: MongoDB application database.
# Example placeholder format: mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=

# Optional: comma-separated email allowlist. If unset, the app uses its built-in
# owner/tester allowlist.
ALLOWED_EMAILS=
